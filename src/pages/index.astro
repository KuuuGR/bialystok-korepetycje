---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import TutorCard from '../components/TutorCard.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import tutorPhoto from '../assets/tutor.jpg';

const lastUpdated = '05.07.2026';

const ofertaItems = [
  {
    icon: '🎓',
    title: 'Matura',
    description:
      'Przygotowanie do matury z fizyki i matematyki na poziomie podstawowym i rozszerzonym — arkusze, strategie egzaminacyjne i powtórki kluczowych zagadnień.',
  },
  {
    icon: '🍎',
    title: 'Biofizyka',
    description:
      'Wsparcie dla studentów kierunków medycznych i przyrodniczych — fizyka stosowana w biologii, zadania z analizy danych i podstaw modelowania.',
  },
  {
    icon: '⚡',
    title: 'Elektrotechnika',
    description:
      'Pomoc na studiach technicznych — obwody prądu stałego i przemiennego, analiza sygnałów, podstawy elektromagnetyzmu i zadania inżynierskie.',
  },
  {
    icon: '🆘',
    title: 'SOS: Szybka Pomoc Przed Sprawdzianem',
    description:
      'Sprawdzian jutro, a w głowie pustka? Intensywna sesja ratunkowa – skondensowana dawka wiedzy, priorytetyzacja materiału i nauka kluczowych trików zadaniowych.',
    premium: true,
  },
];

const recommendedTutors = [
  { name: 'Anna Kowalska', subject: 'Matematyka — szkoła średnia', availability: '4/5' },
  { name: 'Piotr Nowak', subject: 'Fizyka — matura rozszerzona', availability: '5/5' },
  { name: 'Maria Wiśniewska', subject: 'Biofizyka — studia medyczne', availability: '3/5' },
];
---

<Layout canonicalPath="/">
  <p class="border-b border-slate-100 bg-slate-50 py-1.5 text-center text-xs text-gray-500">
    Ostatnia aktualizacja: {lastUpdated}
  </p>

  <Header />

  <main id="main-content">
    <section
      class="border-b border-blue-100 bg-gradient-to-b from-blue-50 via-white to-white"
      aria-labelledby="hero-heading"
    >
      <div class="mx-auto max-w-5xl px-4 py-16 text-center sm:px-6 sm:py-24">
        <p class="mb-4 text-sm font-medium uppercase tracking-widest text-blue-700">
          Białystok
        </p>
        <h1
          id="hero-heading"
          class="mb-6 text-3xl font-bold leading-tight sm:text-4xl md:text-5xl"
        >
          Korepetycje w Białymstoku — Zrozumieć fizykę, nie tylko ją wykuć.
        </h1>
        <p class="mx-auto mb-10 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg">
          Indywidualne lekcje z fizyki i matematyki. Uczę myślenia i samodzielnego rozwiązywania
          zadań — od szkoły średniej po studia.
        </p>
        <a
          href="#kontakt"
          class="inline-block rounded-lg bg-blue-700 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-blue-700 focus:ring-offset-2"
        >
          Umów lekcję próbną
        </a>
      </div>
    </section>

    <section
      id="o-mnie"
      class="border-t border-slate-200 bg-slate-50"
      aria-labelledby="o-mnie-heading"
    >
      <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-20">
        <h2 id="o-mnie-heading" class="mb-2 text-2xl font-bold sm:text-3xl">
          O mnie
        </h2>
        <p class="mb-8 text-lg font-medium text-slate-700">
          Fizyka to nie tylko wzory
        </p>
        <div class="grid items-start gap-8 md:grid-cols-[minmax(0,280px)_1fr] lg:grid-cols-[minmax(0,320px)_1fr] lg:gap-12">
          <figure class="mx-auto w-full max-w-[280px] shrink-0 md:mx-0 lg:max-w-[320px]">
            <OptimizedImage
              src={tutorPhoto}
              alt="Zdjęcie korepetytora z fizyki i matematyki"
              width={tutorPhoto.width}
              height={tutorPhoto.height}
              class="aspect-square w-full rounded-lg border border-slate-200 object-cover shadow-sm"
            />
          </figure>
          <div class="space-y-5 text-base leading-relaxed text-slate-600 sm:text-lg">
            <p>
              Cześć! Nazywam się <strong class="font-semibold text-slate-900">Grzegorz Kulesza</strong> i od
              10 lat pomagam uczniom oswoić fizykę i matematykę. Nie jestem typem korepetytora, który
              bezmyślnie przerabia zadania z kartki na kartkę.
            </p>
            <p>
              Wiem, jak to jest, gdy przedmiot wydaje się czarną magią — sam kiedyś przechodziłem przez
              te same trudności. Dlatego w mojej pracy stawiam na
              <strong class="font-semibold text-slate-900">zrozumienie mechanizmów</strong>, a nie
              pamięciowe opanowanie wzorów. Czy to przygotowanie do matury, biofizyka czy elektrotechnika
              — moją misją jest pokazanie Ci, że te przedmioty mają sens i logikę, które każdy jest w
              stanie pojąć.
            </p>
            <p class="border-l-2 border-blue-200 pl-4 text-slate-600 italic">
              <span class="font-medium not-italic text-slate-700">Prywatnie:</span> pasjonat wiedzy,
              który wierzy, że każdy uczeń ma w sobie potencjał, potrzebuje tylko odpowiedniego „klucza”
              do rozwiązania problemu.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="oferta" class="border-t border-slate-200" aria-labelledby="oferta-heading">
      <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-20">
        <header class="mb-10 text-center">
          <h2 id="oferta-heading" class="text-2xl font-bold sm:text-3xl">
            Oferta
          </h2>
          <p class="mt-3 text-slate-600">
            Wybierz obszar, w którym potrzebujesz wsparcia.
          </p>
        </header>
        <ul class="grid grid-cols-1 gap-6 md:grid-cols-3">
          {
            ofertaItems.map((item) => (
              <li
                class:list={[
                  'rounded-lg p-6 shadow-sm',
                  item.premium
                    ? 'border-2 border-red-300 bg-gradient-to-br from-red-50 via-orange-50 to-amber-50 md:col-span-3'
                    : 'border border-slate-200 bg-white',
                ]}
              >
                {item.premium && (
                  <p class="mb-3">
                    <span class="inline-block rounded-full border border-red-200 bg-red-100 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide text-red-800">
                      Premium · Usługa ratunkowa
                    </span>
                  </p>
                )}
                <h3 class="mb-3 flex items-center gap-2 text-lg font-semibold">
                  <span class="text-xl" aria-hidden="true">{item.icon}</span>
                  {item.title}
                </h3>
                <p
                  class:list={[
                    'text-sm leading-relaxed sm:text-base',
                    item.premium ? 'text-slate-700' : 'text-slate-600',
                  ]}
                >
                  {item.description}
                </p>
              </li>
            ))
          }
        </ul>

        <aside
          class="mt-10 rounded-lg border border-dashed border-slate-300 bg-slate-50 p-5 sm:p-6"
          aria-labelledby="dodatkowe-wsparcie-heading"
        >
          <h3 id="dodatkowe-wsparcie-heading" class="mb-3 text-base font-semibold text-slate-800">
            Dodatkowe wsparcie
          </h3>
          <ul class="mb-4 space-y-1.5 text-sm text-slate-700">
            <li>Podstawy Informatyki</li>
            <li>Wsparcie z języka angielskiego (poziom podstawowy)</li>
          </ul>
          <p class="text-xs leading-relaxed text-slate-500 italic">
            Prowadzę te zajęcia tylko jako uzupełnienie dla moich stałych uczniów z matematyki i fizyki.
          </p>
        </aside>
      </div>
    </section>

    <section
      id="polecani-korepetytorzy"
      class="border-t border-slate-200 bg-slate-50"
      aria-labelledby="polecani-heading"
    >
      <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-20">
        <header class="mb-10 text-center">
          <h2 id="polecani-heading" class="text-2xl font-bold sm:text-3xl">
            Polecani Korepetytorzy
          </h2>
          <p class="mt-3 text-slate-600">
            Zaufani współpracownicy — gdy mój grafik jest pełny, chętnie skieruję Cię dalej.
          </p>
        </header>
        <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            recommendedTutors.map((tutor) => (
              <li>
                <TutorCard
                  name={tutor.name}
                  subject={tutor.subject}
                  availability={tutor.availability}
                />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section
      id="kontakt"
      class="border-t border-slate-200"
      aria-labelledby="kontakt-heading"
    >
      <div class="mx-auto max-w-5xl px-4 py-16 text-center sm:px-6 sm:py-20">
        <h2 id="kontakt-heading" class="mb-4 text-2xl font-bold sm:text-3xl">
          Kontakt
        </h2>
        <p class="mx-auto mb-10 max-w-xl text-base text-slate-600 sm:text-lg">
          Zadzwoń lub napisz, aby umówić pierwszą lekcję lub zadać pytania o ofertę.
        </p>
        <div class="mx-auto flex max-w-md flex-col gap-6">
          <article class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="mb-1 text-sm font-medium uppercase tracking-wide text-slate-500">
              Telefon
            </h3>
            <a
              href="tel:+48792458299"
              class="text-xl font-semibold text-blue-700 transition hover:text-blue-800 hover:underline"
            >
              +48 792 458 299
            </a>
          </article>
          <article class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="mb-1 text-sm font-medium uppercase tracking-wide text-slate-500">
              Lokalizacja
            </h3>
            <address class="not-italic">
              <p class="text-base font-medium text-slate-900">
                Białystok, woj. podlaskie
              </p>
              <p class="mt-1 text-sm text-slate-600">
                Zajęcia stacjonarne w centrum miasta lub online
              </p>
            </address>
          </article>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-5xl px-4 py-8 text-center text-sm text-slate-500 sm:px-6">
      &copy; {new Date().getFullYear()} Korepetycje z Fizyki i Matematyki — Białystok
    </div>
  </footer>
</Layout>
