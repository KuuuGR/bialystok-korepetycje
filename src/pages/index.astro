---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const title = 'Korepetycje z fizyki i matematyki w Białymstoku';

const ofertaItems = [
  {
    title: 'Matura',
    description:
      'Przygotowanie do matury z fizyki i matematyki na poziomie podstawowym i rozszerzonym — arkusze, strategie egzaminacyjne i powtórki kluczowych zagadnień.',
  },
  {
    title: 'Biofizyka',
    description:
      'Wsparcie dla studentów kierunków medycznych i przyrodniczych — fizyka stosowana w biologii, zadania z analizy danych i podstaw modelowania.',
  },
  {
    title: 'Elektrotechnika',
    description:
      'Pomoc na studiach technicznych — obwody prądu stałego i przemiennego, analiza sygnałów, podstawy elektromagnetyzmu i zadania inżynierskie.',
  },
  {
    title: 'Szkoła średnia',
    description:
      'Systematyczna nauka dla uczniów liceum i technikum — od podstaw po zaawansowane zagadnienia, w tym przygotowanie do sprawdzianów i egzaminów klasowych.',
  },
];
---

<Layout title={title} canonicalPath="/">
  <Header />

  <main id="main-content">
    <section
      class="mx-auto max-w-5xl px-4 py-16 text-center sm:px-6 sm:py-24"
      aria-labelledby="hero-heading"
    >
      <p class="mb-4 text-sm font-medium uppercase tracking-widest text-blue-600">
        Białystok
      </p>
      <h1
        id="hero-heading"
        class="mb-6 text-3xl font-bold leading-tight tracking-tight text-slate-900 sm:text-4xl md:text-5xl"
      >
        Korepetycje z Fizyki i Matematyki w Białymstoku
      </h1>
      <p class="mx-auto mb-10 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg">
        Indywidualne lekcje dopasowane do Twoich celów — od szkoły średniej po studia.
        Pomagam zrozumieć materiał, a nie tylko go zapamiętać.
      </p>
      <a
        href="#kontakt"
        class="inline-block rounded-lg bg-blue-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2"
      >
        Umów lekcję próbną
      </a>
    </section>

    <section
      id="o-mnie"
      class="border-t border-slate-200 bg-slate-50"
      aria-labelledby="o-mnie-heading"
    >
      <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-20">
        <h2 id="o-mnie-heading" class="mb-8 text-2xl font-bold text-slate-900 sm:text-3xl">
          O mnie
        </h2>
        <div class="max-w-3xl space-y-5 text-base leading-relaxed text-slate-600 sm:text-lg">
          <p>
            Od ponad <strong class="font-semibold text-slate-900">10 lat</strong> prowadzę
            korepetycje z fizyki i matematyki. Przez ten czas współpracowałem z uczniami
            szkół podstawowych, liceów i techników, a także ze studentami kierunków
            technicznych i medycznych.
          </p>
          <p>
            Mam doświadczenie w pracy ze szkołami — zarówno jako nauczyciel, jak i
            współpracownik przy organizacji zajęć dodatkowych. Znam program nauczania
            i wiem, z jakimi trudnościami uczniowie spotykają się najczęściej na lekcjach
            i egzaminach.
          </p>
          <p>
            W moim podejściu stawiam na <strong class="font-semibold text-slate-900">zrozumienie, a nie wkuwanie</strong>.
            Tłumaczę zagadnienia od podstaw, łączę teorię z praktyką i uczę samodzielnego
            rozwiązywania zadań — tak, aby wiedza zostawała na dłużej i dawała pewność
            na sprawdzianach oraz maturze.
          </p>
        </div>
      </div>
    </section>

    <section id="oferta" class="border-t border-slate-200" aria-labelledby="oferta-heading">
      <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-20">
        <header class="mb-10 text-center">
          <h2 id="oferta-heading" class="text-2xl font-bold text-slate-900 sm:text-3xl">
            Oferta
          </h2>
          <p class="mt-3 text-slate-600">
            Wybierz obszar, w którym potrzebujesz wsparcia.
          </p>
        </header>
        <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:gap-8">
          {
            ofertaItems.map((item) => (
              <li class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:border-blue-200 hover:shadow-md">
                <h3 class="mb-3 text-lg font-semibold text-slate-900">{item.title}</h3>
                <p class="text-sm leading-relaxed text-slate-600 sm:text-base">
                  {item.description}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section
      id="kontakt"
      class="border-t border-slate-200 bg-slate-50"
      aria-labelledby="kontakt-heading"
    >
      <div class="mx-auto max-w-5xl px-4 py-16 text-center sm:px-6 sm:py-20">
        <h2 id="kontakt-heading" class="mb-4 text-2xl font-bold text-slate-900 sm:text-3xl">
          Kontakt
        </h2>
        <p class="mx-auto mb-10 max-w-xl text-base text-slate-600 sm:text-lg">
          Zadzwoń lub napisz, aby umówić pierwszą lekcję lub zadać pytania o ofertę.
        </p>
        <div class="mx-auto flex max-w-md flex-col gap-6">
          <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="mb-1 text-sm font-medium uppercase tracking-wide text-slate-500">
              Telefon
            </h3>
            <a
              href="tel:+48123456789"
              class="text-xl font-semibold text-blue-600 transition hover:text-blue-700"
            >
              +48 123 456 789
            </a>
          </article>
          <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="mb-1 text-sm font-medium uppercase tracking-wide text-slate-500">
              Lokalizacja
            </h3>
            <address class="not-italic">
              <p class="text-base font-medium text-slate-900">
                Białystok, woj. podlaskie
              </p>
              <p class="mt-1 text-sm text-slate-600">
                Zajęcia stacjonarne w centrum miasta lub online
              </p>
            </address>
          </article>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-slate-200">
    <div class="mx-auto max-w-5xl px-4 py-8 text-center text-sm text-slate-500 sm:px-6">
      &copy; {new Date().getFullYear()} Korepetycje z fizyki i matematyki — Białystok
    </div>
  </footer>
</Layout>
