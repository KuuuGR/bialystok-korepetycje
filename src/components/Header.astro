---
const navItems = [
  { label: 'O mnie', href: '#o-mnie' },
  { label: 'Oferta', href: '#oferta' },
  { label: 'Kontakt', href: '#kontakt' },
];
---

<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur-sm">
  <div class="mx-auto max-w-5xl px-4 py-4 sm:px-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <a
        href="/"
        class="text-center text-lg font-semibold tracking-tight text-slate-900 sm:text-left"
      >
        Fizyka &amp; Matematyka
      </a>
      <nav aria-label="Główne menu">
        <ul class="flex flex-wrap items-center justify-center gap-1 sm:justify-end sm:gap-2">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="rounded-md px-3 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>
