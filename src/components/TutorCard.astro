---
interface Props {
  name: string;
  subject: string;
  availability: string;
}

const { name, subject, availability } = Astro.props;
---

<article class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
  <h3 class="mb-1 text-lg font-semibold">{name}</h3>
  <p class="mb-3 text-sm text-slate-600">{subject}</p>
  <p class="text-sm font-medium text-slate-700">
    <span class="text-slate-500">Dostępność:</span> {availability}
  </p>
</article>
